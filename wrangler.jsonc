// Cloudflare Workers static assets (for the planned move off Netlify): deploys dist/ as-is.
// Having this file also stops `wrangler deploy` from auto-configuring the project.
// The Supabase VITE_* variables must be set as build variables in the Worker's settings.
{
  "name": "antecedent-web-app",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./dist",
    // Single-page app: unknown paths serve index.html and react-router takes over.
    "not_found_handling": "single-page-application"
  },
  // Lets Workers Builds publish a Preview for non-production branches (`wrangler preview`).
  "previews": {}
}
